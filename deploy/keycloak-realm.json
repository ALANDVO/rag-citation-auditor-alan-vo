{
  "realm": "rag-citation-auditor",
  "enabled": true,
  "displayName": "RAG Citation Auditor Realm",
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to audit reports and inspection views"
      },
      {
        "name": "analyst",
        "description": "Can trigger audits and perform evidence reviews"
      },
      {
        "name": "admin",
        "description": "Full administrative access including audit configuration"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rag-auditor-backend",
      "name": "RAG Citation Auditor Backend Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:8000/api/v1/auth/callback",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://127.0.0.1:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "enterprise-saml-idp",
      "displayName": "Enterprise SAML 2.0 Identity Provider",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "config": {
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "singleSignOnServiceUrl": "https://idp.example.com/saml/sso",
        "entityId": "http://127.0.0.1:8080/realms/rag-citation-auditor",
        "syncMode": "IMPORT"
      }
    }
  ]
}
