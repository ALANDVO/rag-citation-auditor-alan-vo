# Application Environment
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./auditor.db
SECRET_KEY=change-in-production-to-a-secure-random-secret

# Demo Mode (Local development only; startup refuses demo mode in production)
DEMO_MODE=true

# OIDC / Keycloak Configuration
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/rag-citation-auditor
OIDC_CLIENT_ID=rag-auditor-backend
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
OIDC_COOKIE_NAME=auditor_session
SESSION_SECRET=change-in-production-session-secret

# LLM Advisory Provider Settings (Optional; deterministic engine works offline without key)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://llm.chris-vo.com/v1
